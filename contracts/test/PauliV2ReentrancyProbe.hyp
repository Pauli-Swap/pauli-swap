pragma hyperion >=0.0;

import {IPauliV2Callee} from "../v2/core/interfaces/IPauliV2Callee.hyp";
import {IPauliV2Pair} from "../v2/core/interfaces/IPauliV2Pair.hyp";

/// @notice Calls back into the pair from inside the swap callback so the test
/// can prove the `lock` modifier rejects reentrancy.
contract PauliV2ReentrancyProbe is IPauliV2Callee {
    function attack(address pair) external {
        IPauliV2Pair(pair).swap(1, 0, address(this), abi.encode(uint256(1)));
    }

    function pauliV2Call(address, uint256, uint256, bytes calldata) external {
        IPauliV2Pair(msg.sender).sync();
    }
}
