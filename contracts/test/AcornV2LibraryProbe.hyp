pragma hyperion >=0.0;

import {AcornV2Library} from "../v2/periphery/libraries/AcornV2Library.hyp";

/// @notice Exposes the internal library so tests can assert the pinned
/// PAIR_INIT_CODE_HASH still derives the address the factory actually deploys.
contract AcornV2LibraryProbe {
    function pairFor(address factory, address tokenA, address tokenB) external pure returns (address) {
        return AcornV2Library.pairFor(factory, tokenA, tokenB);
    }

    function initCodeHash() external pure returns (bytes32) {
        return AcornV2Library.PAIR_INIT_CODE_HASH;
    }

    function getAmountOut(uint256 amountIn, uint256 reserveIn, uint256 reserveOut)
        external
        pure
        returns (uint256)
    {
        return AcornV2Library.getAmountOut(amountIn, reserveIn, reserveOut);
    }

    function getAmountIn(uint256 amountOut, uint256 reserveIn, uint256 reserveOut)
        external
        pure
        returns (uint256)
    {
        return AcornV2Library.getAmountIn(amountOut, reserveIn, reserveOut);
    }
}
