pragma hyperion >=0.0;

import {IAcornV3Pool} from "../v3/core/interfaces/IAcornV3Pool.hyp";
import {ISQRCTF1Minimal} from "../v3/core/interfaces/ISQRCTF1Minimal.hyp";
import {
    IAcornV3MintCallback,
    IAcornV3SwapCallback,
    IAcornV3FlashCallback
} from "../v3/core/interfaces/callback/IAcornV3Callbacks.hyp";

/// @notice Minimal counterparty for the V3 pool used by the core test suite. It
/// pays every callback out of its own balance, which is what lets the tests
/// exercise the pool without the periphery.
contract AcornV3PoolCaller is
    IAcornV3MintCallback,
    IAcornV3SwapCallback,
    IAcornV3FlashCallback
{
    function mint(address pool, address recipient, int24 tickLower, int24 tickUpper, uint128 amount)
        external
        returns (uint256 amount0, uint256 amount1)
    {
        return IAcornV3Pool(pool).mint(recipient, tickLower, tickUpper, amount, abi.encode(msg.sender));
    }

    function swap(
        address pool,
        address recipient,
        bool zeroForOne,
        int256 amountSpecified,
        uint160 sqrtPriceLimitX96
    ) external returns (int256 amount0, int256 amount1) {
        return IAcornV3Pool(pool).swap(
            recipient, zeroForOne, amountSpecified, sqrtPriceLimitX96, abi.encode(msg.sender)
        );
    }

    function flash(address pool, address recipient, uint256 amount0, uint256 amount1) external {
        IAcornV3Pool(pool).flash(recipient, amount0, amount1, abi.encode(msg.sender));
    }

    function acornV3MintCallback(uint256 amount0Owed, uint256 amount1Owed, bytes calldata data) external {
        address payer = abi.decode(data, (address));
        if (amount0Owed > 0) {
            ISQRCTF1Minimal(IAcornV3Pool(msg.sender).token0()).transferFrom(payer, msg.sender, amount0Owed);
        }
        if (amount1Owed > 0) {
            ISQRCTF1Minimal(IAcornV3Pool(msg.sender).token1()).transferFrom(payer, msg.sender, amount1Owed);
        }
    }

    function acornV3SwapCallback(int256 amount0Delta, int256 amount1Delta, bytes calldata data) external {
        address payer = abi.decode(data, (address));
        if (amount0Delta > 0) {
            ISQRCTF1Minimal(IAcornV3Pool(msg.sender).token0()).transferFrom(
                payer, msg.sender, uint256(amount0Delta)
            );
        }
        if (amount1Delta > 0) {
            ISQRCTF1Minimal(IAcornV3Pool(msg.sender).token1()).transferFrom(
                payer, msg.sender, uint256(amount1Delta)
            );
        }
    }

    function acornV3FlashCallback(uint256 fee0, uint256 fee1, bytes calldata data) external {
        address payer = abi.decode(data, (address));
        IAcornV3Pool pool = IAcornV3Pool(msg.sender);
        ISQRCTF1Minimal token0 = ISQRCTF1Minimal(pool.token0());
        ISQRCTF1Minimal token1 = ISQRCTF1Minimal(pool.token1());
        token0.transfer(msg.sender, token0.balanceOf(address(this)));
        token1.transfer(msg.sender, token1.balanceOf(address(this)));
        if (fee0 > 0) token0.transferFrom(payer, msg.sender, fee0);
        if (fee1 > 0) token1.transferFrom(payer, msg.sender, fee1);
    }
}
