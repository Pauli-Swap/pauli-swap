pragma hyperion >=0.0;

import {IPauliV3Pool} from "../../core/interfaces/IPauliV3Pool.hyp";
import {PoolAddress} from "./PoolAddress.hyp";

/// @notice Provides validation for callbacks from Pauli V3 pools
library CallbackValidation {
    function verifyCallback(address factory, address tokenA, address tokenB, uint24 fee)
        internal
        view
        returns (IPauliV3Pool pool)
    {
        return verifyCallback(factory, PoolAddress.getPoolKey(tokenA, tokenB, fee));
    }

    /// @dev Reverts unless msg.sender is the pool the key derives to, which is
    /// what stops an arbitrary contract from calling the swap callback and
    /// draining an approved balance.
    function verifyCallback(address factory, PoolAddress.PoolKey memory poolKey)
        internal
        view
        returns (IPauliV3Pool pool)
    {
        pool = IPauliV3Pool(PoolAddress.computeAddress(factory, poolKey));
        require(msg.sender == address(pool));
    }
}
