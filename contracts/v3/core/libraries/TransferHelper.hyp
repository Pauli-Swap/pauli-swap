pragma hyperion >=0.0;

import {ISQRCTF1Minimal} from "../interfaces/ISQRCTF1Minimal.hyp";

/// @title TransferHelper
/// @notice Contains helper methods for interacting with SQRC-TF1 tokens that do
/// not consistently return true or false
library TransferHelper {
    /// @notice Transfers tokens from msg.sender to a recipient
    /// @dev Calls transfer on the token contract, errors with TF if transfer fails
    function safeTransfer(address token, address to, uint256 value) internal {
        (bool success, bytes memory data) =
            token.call(abi.encodeWithSelector(ISQRCTF1Minimal.transfer.selector, to, value));
        require(success && (data.length == 0 || abi.decode(data, (bool))), "TF");
    }
}
