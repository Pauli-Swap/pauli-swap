pragma hyperion >=0.0;

/// @title Callback for IPauliV3PoolActions#mint
interface IPauliV3MintCallback {
    /// @notice Called to `msg.sender` after minting liquidity to a position
    /// @dev The caller must be a PauliV3Pool deployed by the canonical factory
    function pauliV3MintCallback(uint256 amount0Owed, uint256 amount1Owed, bytes calldata data) external;
}

/// @title Callback for IPauliV3PoolActions#swap
interface IPauliV3SwapCallback {
    /// @notice Called to `msg.sender` after executing a swap
    /// @dev Amounts are deltas: positive means the pool is owed that token
    function pauliV3SwapCallback(int256 amount0Delta, int256 amount1Delta, bytes calldata data) external;
}

/// @title Callback for IPauliV3PoolActions#flash
interface IPauliV3FlashCallback {
    /// @notice Called to `msg.sender` after transferring flash borrowed tokens
    function pauliV3FlashCallback(uint256 fee0, uint256 fee1, bytes calldata data) external;
}
