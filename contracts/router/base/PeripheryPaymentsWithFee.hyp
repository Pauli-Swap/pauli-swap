pragma hyperion >=0.0;

import {ISQRCTF1Minimal} from "../../v3/core/interfaces/ISQRCTF1Minimal.hyp";
import {IWQRL9} from "../../v3/periphery/interfaces/IWQRL9.hyp";
import {TransferHelper} from "../../v3/periphery/libraries/TransferHelper.hyp";
import {PeripheryPayments} from "../../v3/periphery/base/PeripheryPayments.hyp";

/// @title Periphery payments with fee
/// @notice Port of Uniswap's PeripheryPaymentsWithFee and
/// PeripheryPaymentsExtended. A front end takes its fee by swapping to the
/// router and paying out with one of the *WithFee calls; nothing here charges
/// a caller who does not ask for it.
/// @dev The Extended overloads that default the recipient to msg.sender are
/// left out: the QRL web3.js client cannot pick between overloaded names, and
/// Constants.MSG_SENDER is not needed for a payout that names its recipient.
abstract contract PeripheryPaymentsWithFee is PeripheryPayments {
    /// @notice Unwraps the contract's WQRL9 balance and sends it to recipient as QRL, with a percentage between
    /// 0 (exclusive), and 1 (inclusive) going to feeRecipient
    /// @dev The amountMinimum parameter prevents malicious contracts from stealing WQRL9 from users.
    function unwrapWQRL9WithFee(uint256 amountMinimum, address recipient, uint256 feeBips, address feeRecipient)
        public
        payable
    {
        require(feeBips > 0 && feeBips <= 100);

        uint256 balanceWQRL9 = IWQRL9(WQRL9).balanceOf(address(this));
        require(balanceWQRL9 >= amountMinimum, "Insufficient WQRL9");

        if (balanceWQRL9 > 0) {
            IWQRL9(WQRL9).withdraw(balanceWQRL9);
            uint256 feeAmount = balanceWQRL9 * feeBips / 10_000;
            if (feeAmount > 0) TransferHelper.safeTransferQRL(feeRecipient, feeAmount);
            TransferHelper.safeTransferQRL(recipient, balanceWQRL9 - feeAmount);
        }
    }

    /// @notice Transfers the full amount of a token held by this contract to recipient, with a percentage between
    /// 0 (exclusive) and 1 (inclusive) going to feeRecipient
    /// @dev The amountMinimum parameter prevents malicious contracts from stealing the token from users
    function sweepTokenWithFee(
        address token,
        uint256 amountMinimum,
        address recipient,
        uint256 feeBips,
        address feeRecipient
    ) public payable {
        require(feeBips > 0 && feeBips <= 100);

        uint256 balanceToken = ISQRCTF1Minimal(token).balanceOf(address(this));
        require(balanceToken >= amountMinimum, "Insufficient token");

        if (balanceToken > 0) {
            uint256 feeAmount = balanceToken * feeBips / 10_000;
            if (feeAmount > 0) TransferHelper.safeTransfer(token, feeRecipient, feeAmount);
            TransferHelper.safeTransfer(token, recipient, balanceToken - feeAmount);
        }
    }

    /// @notice Wraps the contract's QRL balance into WQRL9
    /// @dev The resulting WQRL9 is custodied by the router, thus will require further distribution
    function wrapQRL(uint256 value) external payable {
        IWQRL9(WQRL9).deposit{value: value}();
    }

    /// @notice Transfers the specified amount of a token from the msg.sender to address(this)
    function pull(address token, uint256 value) external payable {
        TransferHelper.safeTransferFrom(token, msg.sender, address(this), value);
    }
}
