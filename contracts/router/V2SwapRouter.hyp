pragma hyperion >=0.0;

import {ISQRCTF1Minimal} from "../v3/core/interfaces/ISQRCTF1Minimal.hyp";
import {IPauliV2Pair} from "../v2/core/interfaces/IPauliV2Pair.hyp";
import {PauliV2Library} from "../v2/periphery/libraries/PauliV2Library.hyp";
import {IV2SwapRouter} from "./interfaces/IV2SwapRouter.hyp";
import {ImmutableState} from "./base/ImmutableState.hyp";
import {PeripheryPaymentsWithFee} from "./base/PeripheryPaymentsWithFee.hyp";
import {Constants} from "./libraries/Constants.hyp";

/// @title Pauli V2 Swap Router
/// @notice Router for stateless execution of swaps against Pauli V2. Port of
/// Uniswap's V2SwapRouter (swap-router-contracts). Every swap measures what
/// the pair received, so fee-on-transfer tokens work without separate entry
/// points.
abstract contract V2SwapRouter is IV2SwapRouter, ImmutableState, PeripheryPaymentsWithFee {
    /// @dev Requires the initial amount to have already been sent to the first pair
    function _swap(address[] memory path, address _to) private {
        for (uint256 i; i < path.length - 1; i++) {
            (address input, address output) = (path[i], path[i + 1]);
            (address token0,) = PauliV2Library.sortTokens(input, output);
            IPauliV2Pair pair = IPauliV2Pair(PauliV2Library.pairFor(factoryV2, input, output));
            uint256 amountInput;
            uint256 amountOutput;
            // scope to avoid stack too deep errors
            {
                (uint256 reserve0, uint256 reserve1,) = pair.getReserves();
                (uint256 reserveInput, uint256 reserveOutput) =
                    input == token0 ? (reserve0, reserve1) : (reserve1, reserve0);
                amountInput = ISQRCTF1Minimal(input).balanceOf(address(pair)) - reserveInput;
                amountOutput = PauliV2Library.getAmountOut(amountInput, reserveInput, reserveOutput);
            }
            (uint256 amount0Out, uint256 amount1Out) =
                input == token0 ? (uint256(0), amountOutput) : (amountOutput, uint256(0));
            address to = i < path.length - 2 ? PauliV2Library.pairFor(factoryV2, output, path[i + 2]) : _to;
            pair.swap(amount0Out, amount1Out, to, new bytes(0));
        }
    }

    function swapExactTokensForTokens(uint256 amountIn, uint256 amountOutMin, address[] calldata path, address to)
        external
        payable
        override
        returns (uint256 amountOut)
    {
        // use amountIn == Constants.CONTRACT_BALANCE as a flag to swap the entire balance of the contract
        bool hasAlreadyPaid;
        if (amountIn == Constants.CONTRACT_BALANCE) {
            hasAlreadyPaid = true;
            amountIn = ISQRCTF1Minimal(path[0]).balanceOf(address(this));
        }

        pay(
            path[0],
            hasAlreadyPaid ? address(this) : msg.sender,
            PauliV2Library.pairFor(factoryV2, path[0], path[1]),
            amountIn
        );

        // find and replace to addresses
        if (to == Constants.MSG_SENDER) to = msg.sender;
        else if (to == Constants.ADDRESS_THIS) to = address(this);

        uint256 balanceBefore = ISQRCTF1Minimal(path[path.length - 1]).balanceOf(to);

        _swap(path, to);

        amountOut = ISQRCTF1Minimal(path[path.length - 1]).balanceOf(to) - balanceBefore;
        require(amountOut >= amountOutMin, "Too little received");
    }

    function swapTokensForExactTokens(uint256 amountOut, uint256 amountInMax, address[] calldata path, address to)
        external
        payable
        override
        returns (uint256 amountIn)
    {
        amountIn = PauliV2Library.getAmountsIn(factoryV2, amountOut, path)[0];
        require(amountIn <= amountInMax, "Too much requested");

        pay(path[0], msg.sender, PauliV2Library.pairFor(factoryV2, path[0], path[1]), amountIn);

        // find and replace to addresses
        if (to == Constants.MSG_SENDER) to = msg.sender;
        else if (to == Constants.ADDRESS_THIS) to = address(this);

        _swap(path, to);
    }
}
