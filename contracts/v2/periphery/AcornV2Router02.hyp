pragma hyperion >=0.0;

import {IAcornV2Router02} from "./interfaces/IAcornV2Router02.hyp";
import {IWQRL} from "./interfaces/IWQRL.hyp";
import {IAcornV2Factory} from "../core/interfaces/IAcornV2Factory.hyp";
import {IAcornV2Pair} from "../core/interfaces/IAcornV2Pair.hyp";
import {IAcornV2SQRCTF1} from "../core/interfaces/IAcornV2SQRCTF1.hyp";
import {AcornV2Library} from "./libraries/AcornV2Library.hyp";
import {TransferHelper} from "./libraries/TransferHelper.hyp";

contract AcornV2Router02 is IAcornV2Router02 {
    address public immutable factory;
    address public immutable WQRL;

    modifier ensure(uint256 deadline) {
        require(deadline >= block.timestamp, "AcornV2Router: EXPIRED");
        _;
    }

    constructor(address _factory, address _WQRL) {
        factory = _factory;
        WQRL = _WQRL;
    }

    receive() external payable {
        assert(msg.sender == WQRL);
    }

    function _addLiquidity(
        address tokenA,
        address tokenB,
        uint256 amountADesired,
        uint256 amountBDesired,
        uint256 amountAMin,
        uint256 amountBMin
    ) internal virtual returns (uint256 amountA, uint256 amountB) {
        if (IAcornV2Factory(factory).getPair(tokenA, tokenB) == address(0)) {
            IAcornV2Factory(factory).createPair(tokenA, tokenB);
        }
        (uint256 reserveA, uint256 reserveB) = AcornV2Library.getReserves(factory, tokenA, tokenB);
        if (reserveA == 0 && reserveB == 0) {
            (amountA, amountB) = (amountADesired, amountBDesired);
        } else {
            uint256 amountBOptimal = AcornV2Library.quote(amountADesired, reserveA, reserveB);
            if (amountBOptimal <= amountBDesired) {
                require(amountBOptimal >= amountBMin, "AcornV2Router: INSUFFICIENT_B_AMOUNT");
                (amountA, amountB) = (amountADesired, amountBOptimal);
            } else {
                uint256 amountAOptimal = AcornV2Library.quote(amountBDesired, reserveB, reserveA);
                assert(amountAOptimal <= amountADesired);
                require(amountAOptimal >= amountAMin, "AcornV2Router: INSUFFICIENT_A_AMOUNT");
                (amountA, amountB) = (amountAOptimal, amountBDesired);
            }
        }
    }

    function addLiquidity(
        address tokenA,
        address tokenB,
        uint256 amountADesired,
        uint256 amountBDesired,
        uint256 amountAMin,
        uint256 amountBMin,
        address to,
        uint256 deadline
    ) external virtual ensure(deadline) returns (uint256 amountA, uint256 amountB, uint256 liquidity) {
        (amountA, amountB) = _addLiquidity(tokenA, tokenB, amountADesired, amountBDesired, amountAMin, amountBMin);
        address pair = AcornV2Library.pairFor(factory, tokenA, tokenB);
        TransferHelper.safeTransferFrom(tokenA, msg.sender, pair, amountA);
        TransferHelper.safeTransferFrom(tokenB, msg.sender, pair, amountB);
        liquidity = IAcornV2Pair(pair).mint(to);
    }

    function addLiquidityQRL(
        address token,
        uint256 amountTokenDesired,
        uint256 amountTokenMin,
        uint256 amountQRLMin,
        address to,
        uint256 deadline
    )
        external
        payable
        virtual
        ensure(deadline)
        returns (uint256 amountToken, uint256 amountQRL, uint256 liquidity)
    {
        (amountToken, amountQRL) =
            _addLiquidity(token, WQRL, amountTokenDesired, msg.value, amountTokenMin, amountQRLMin);
        address pair = AcornV2Library.pairFor(factory, token, WQRL);
        TransferHelper.safeTransferFrom(token, msg.sender, pair, amountToken);
        IWQRL(WQRL).deposit{value: amountQRL}();
        assert(IWQRL(WQRL).transfer(pair, amountQRL));
        liquidity = IAcornV2Pair(pair).mint(to);
        if (msg.value > amountQRL) TransferHelper.safeTransferQRL(msg.sender, msg.value - amountQRL);
    }

    function removeLiquidity(
        address tokenA,
        address tokenB,
        uint256 liquidity,
        uint256 amountAMin,
        uint256 amountBMin,
        address to,
        uint256 deadline
    ) public virtual ensure(deadline) returns (uint256 amountA, uint256 amountB) {
        address pair = AcornV2Library.pairFor(factory, tokenA, tokenB);
        IAcornV2Pair(pair).transferFrom(msg.sender, pair, liquidity);
        (uint256 amount0, uint256 amount1) = IAcornV2Pair(pair).burn(to);
        (address token0,) = AcornV2Library.sortTokens(tokenA, tokenB);
        (amountA, amountB) = tokenA == token0 ? (amount0, amount1) : (amount1, amount0);
        require(amountA >= amountAMin, "AcornV2Router: INSUFFICIENT_A_AMOUNT");
        require(amountB >= amountBMin, "AcornV2Router: INSUFFICIENT_B_AMOUNT");
    }

    function removeLiquidityQRL(
        address token,
        uint256 liquidity,
        uint256 amountTokenMin,
        uint256 amountQRLMin,
        address to,
        uint256 deadline
    ) public virtual ensure(deadline) returns (uint256 amountToken, uint256 amountQRL) {
        (amountToken, amountQRL) =
            removeLiquidity(token, WQRL, liquidity, amountTokenMin, amountQRLMin, address(this), deadline);
        TransferHelper.safeTransfer(token, to, amountToken);
        IWQRL(WQRL).withdraw(amountQRL);
        TransferHelper.safeTransferQRL(to, amountQRL);
    }

    function removeLiquidityQRLSupportingFeeOnTransferTokens(
        address token,
        uint256 liquidity,
        uint256 amountTokenMin,
        uint256 amountQRLMin,
        address to,
        uint256 deadline
    ) public virtual ensure(deadline) returns (uint256 amountQRL) {
        (, amountQRL) =
            removeLiquidity(token, WQRL, liquidity, amountTokenMin, amountQRLMin, address(this), deadline);
        TransferHelper.safeTransfer(token, to, IAcornV2SQRCTF1(token).balanceOf(address(this)));
        IWQRL(WQRL).withdraw(amountQRL);
        TransferHelper.safeTransferQRL(to, amountQRL);
    }

    /// @dev Requires the input amount to already sit in the first pair.
    function _swap(uint256[] memory amounts, address[] memory path, address _to) internal virtual {
        for (uint256 i; i < path.length - 1; i++) {
            (address input, address output) = (path[i], path[i + 1]);
            (address token0,) = AcornV2Library.sortTokens(input, output);
            uint256 amountOut = amounts[i + 1];
            (uint256 amount0Out, uint256 amount1Out) =
                input == token0 ? (uint256(0), amountOut) : (amountOut, uint256(0));
            address to = i < path.length - 2 ? AcornV2Library.pairFor(factory, output, path[i + 2]) : _to;
            IAcornV2Pair(AcornV2Library.pairFor(factory, input, output)).swap(
                amount0Out, amount1Out, to, new bytes(0)
            );
        }
    }

    function swapExactTokensForTokens(
        uint256 amountIn,
        uint256 amountOutMin,
        address[] calldata path,
        address to,
        uint256 deadline
    ) external virtual ensure(deadline) returns (uint256[] memory amounts) {
        amounts = AcornV2Library.getAmountsOut(factory, amountIn, path);
        require(amounts[amounts.length - 1] >= amountOutMin, "AcornV2Router: INSUFFICIENT_OUTPUT_AMOUNT");
        TransferHelper.safeTransferFrom(
            path[0], msg.sender, AcornV2Library.pairFor(factory, path[0], path[1]), amounts[0]
        );
        _swap(amounts, path, to);
    }

    function swapTokensForExactTokens(
        uint256 amountOut,
        uint256 amountInMax,
        address[] calldata path,
        address to,
        uint256 deadline
    ) external virtual ensure(deadline) returns (uint256[] memory amounts) {
        amounts = AcornV2Library.getAmountsIn(factory, amountOut, path);
        require(amounts[0] <= amountInMax, "AcornV2Router: EXCESSIVE_INPUT_AMOUNT");
        TransferHelper.safeTransferFrom(
            path[0], msg.sender, AcornV2Library.pairFor(factory, path[0], path[1]), amounts[0]
        );
        _swap(amounts, path, to);
    }

    function swapExactQRLForTokens(
        uint256 amountOutMin,
        address[] calldata path,
        address to,
        uint256 deadline
    ) external payable virtual ensure(deadline) returns (uint256[] memory amounts) {
        require(path[0] == WQRL, "AcornV2Router: INVALID_PATH");
        amounts = AcornV2Library.getAmountsOut(factory, msg.value, path);
        require(amounts[amounts.length - 1] >= amountOutMin, "AcornV2Router: INSUFFICIENT_OUTPUT_AMOUNT");
        IWQRL(WQRL).deposit{value: amounts[0]}();
        assert(IWQRL(WQRL).transfer(AcornV2Library.pairFor(factory, path[0], path[1]), amounts[0]));
        _swap(amounts, path, to);
    }

    function swapTokensForExactQRL(
        uint256 amountOut,
        uint256 amountInMax,
        address[] calldata path,
        address to,
        uint256 deadline
    ) external virtual ensure(deadline) returns (uint256[] memory amounts) {
        require(path[path.length - 1] == WQRL, "AcornV2Router: INVALID_PATH");
        amounts = AcornV2Library.getAmountsIn(factory, amountOut, path);
        require(amounts[0] <= amountInMax, "AcornV2Router: EXCESSIVE_INPUT_AMOUNT");
        TransferHelper.safeTransferFrom(
            path[0], msg.sender, AcornV2Library.pairFor(factory, path[0], path[1]), amounts[0]
        );
        _swap(amounts, path, address(this));
        IWQRL(WQRL).withdraw(amounts[amounts.length - 1]);
        TransferHelper.safeTransferQRL(to, amounts[amounts.length - 1]);
    }

    function swapExactTokensForQRL(
        uint256 amountIn,
        uint256 amountOutMin,
        address[] calldata path,
        address to,
        uint256 deadline
    ) external virtual ensure(deadline) returns (uint256[] memory amounts) {
        require(path[path.length - 1] == WQRL, "AcornV2Router: INVALID_PATH");
        amounts = AcornV2Library.getAmountsOut(factory, amountIn, path);
        require(amounts[amounts.length - 1] >= amountOutMin, "AcornV2Router: INSUFFICIENT_OUTPUT_AMOUNT");
        TransferHelper.safeTransferFrom(
            path[0], msg.sender, AcornV2Library.pairFor(factory, path[0], path[1]), amounts[0]
        );
        _swap(amounts, path, address(this));
        IWQRL(WQRL).withdraw(amounts[amounts.length - 1]);
        TransferHelper.safeTransferQRL(to, amounts[amounts.length - 1]);
    }

    function swapQRLForExactTokens(
        uint256 amountOut,
        address[] calldata path,
        address to,
        uint256 deadline
    ) external payable virtual ensure(deadline) returns (uint256[] memory amounts) {
        require(path[0] == WQRL, "AcornV2Router: INVALID_PATH");
        amounts = AcornV2Library.getAmountsIn(factory, amountOut, path);
        require(amounts[0] <= msg.value, "AcornV2Router: EXCESSIVE_INPUT_AMOUNT");
        IWQRL(WQRL).deposit{value: amounts[0]}();
        assert(IWQRL(WQRL).transfer(AcornV2Library.pairFor(factory, path[0], path[1]), amounts[0]));
        _swap(amounts, path, to);
        if (msg.value > amounts[0]) TransferHelper.safeTransferQRL(msg.sender, msg.value - amounts[0]);
    }

    /// @dev Requires the input amount to already sit in the first pair.
    function _swapSupportingFeeOnTransferTokens(address[] memory path, address _to) internal virtual {
        for (uint256 i; i < path.length - 1; i++) {
            (address input, address output) = (path[i], path[i + 1]);
            (address token0,) = AcornV2Library.sortTokens(input, output);
            IAcornV2Pair pair = IAcornV2Pair(AcornV2Library.pairFor(factory, input, output));
            uint256 amountInput;
            uint256 amountOutput;
            {
                (uint256 reserve0, uint256 reserve1,) = pair.getReserves();
                (uint256 reserveInput, uint256 reserveOutput) =
                    input == token0 ? (reserve0, reserve1) : (reserve1, reserve0);
                amountInput = IAcornV2SQRCTF1(input).balanceOf(address(pair)) - reserveInput;
                amountOutput = AcornV2Library.getAmountOut(amountInput, reserveInput, reserveOutput);
            }
            (uint256 amount0Out, uint256 amount1Out) =
                input == token0 ? (uint256(0), amountOutput) : (amountOutput, uint256(0));
            address to = i < path.length - 2 ? AcornV2Library.pairFor(factory, output, path[i + 2]) : _to;
            pair.swap(amount0Out, amount1Out, to, new bytes(0));
        }
    }

    function swapExactTokensForTokensSupportingFeeOnTransferTokens(
        uint256 amountIn,
        uint256 amountOutMin,
        address[] calldata path,
        address to,
        uint256 deadline
    ) external virtual ensure(deadline) {
        TransferHelper.safeTransferFrom(
            path[0], msg.sender, AcornV2Library.pairFor(factory, path[0], path[1]), amountIn
        );
        uint256 balanceBefore = IAcornV2SQRCTF1(path[path.length - 1]).balanceOf(to);
        _swapSupportingFeeOnTransferTokens(path, to);
        require(
            IAcornV2SQRCTF1(path[path.length - 1]).balanceOf(to) - balanceBefore >= amountOutMin,
            "AcornV2Router: INSUFFICIENT_OUTPUT_AMOUNT"
        );
    }

    function swapExactQRLForTokensSupportingFeeOnTransferTokens(
        uint256 amountOutMin,
        address[] calldata path,
        address to,
        uint256 deadline
    ) external payable virtual ensure(deadline) {
        require(path[0] == WQRL, "AcornV2Router: INVALID_PATH");
        uint256 amountIn = msg.value;
        IWQRL(WQRL).deposit{value: amountIn}();
        assert(IWQRL(WQRL).transfer(AcornV2Library.pairFor(factory, path[0], path[1]), amountIn));
        uint256 balanceBefore = IAcornV2SQRCTF1(path[path.length - 1]).balanceOf(to);
        _swapSupportingFeeOnTransferTokens(path, to);
        require(
            IAcornV2SQRCTF1(path[path.length - 1]).balanceOf(to) - balanceBefore >= amountOutMin,
            "AcornV2Router: INSUFFICIENT_OUTPUT_AMOUNT"
        );
    }

    function swapExactTokensForQRLSupportingFeeOnTransferTokens(
        uint256 amountIn,
        uint256 amountOutMin,
        address[] calldata path,
        address to,
        uint256 deadline
    ) external virtual ensure(deadline) {
        require(path[path.length - 1] == WQRL, "AcornV2Router: INVALID_PATH");
        TransferHelper.safeTransferFrom(
            path[0], msg.sender, AcornV2Library.pairFor(factory, path[0], path[1]), amountIn
        );
        _swapSupportingFeeOnTransferTokens(path, address(this));
        uint256 amountOut = IAcornV2SQRCTF1(WQRL).balanceOf(address(this));
        require(amountOut >= amountOutMin, "AcornV2Router: INSUFFICIENT_OUTPUT_AMOUNT");
        IWQRL(WQRL).withdraw(amountOut);
        TransferHelper.safeTransferQRL(to, amountOut);
    }

    function quote(uint256 amountA, uint256 reserveA, uint256 reserveB)
        public
        pure
        virtual
        returns (uint256 amountB)
    {
        return AcornV2Library.quote(amountA, reserveA, reserveB);
    }

    function getAmountOut(uint256 amountIn, uint256 reserveIn, uint256 reserveOut)
        public
        pure
        virtual
        returns (uint256 amountOut)
    {
        return AcornV2Library.getAmountOut(amountIn, reserveIn, reserveOut);
    }

    function getAmountIn(uint256 amountOut, uint256 reserveIn, uint256 reserveOut)
        public
        pure
        virtual
        returns (uint256 amountIn)
    {
        return AcornV2Library.getAmountIn(amountOut, reserveIn, reserveOut);
    }

    function getAmountsOut(uint256 amountIn, address[] memory path)
        public
        view
        virtual
        returns (uint256[] memory amounts)
    {
        return AcornV2Library.getAmountsOut(factory, amountIn, path);
    }

    function getAmountsIn(uint256 amountOut, address[] memory path)
        public
        view
        virtual
        returns (uint256[] memory amounts)
    {
        return AcornV2Library.getAmountsIn(factory, amountOut, path);
    }
}
