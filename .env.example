# QRL Zond testnet v2
QRL_RPC_URL="https://qrlwallet.com/api/qrl-rpc/testnet"
QRL_CHAIN_ID=1337

# Deployer secret. Never commit the real value.
DEPLOYER_MNEMONIC=""

# Existing WQRL deployment to reuse. Several WQRL contracts exist on the
# testnet; set this so the deploy scripts wire the routers to the intended one
# instead of publishing another. Q prefixed, 40 hex characters.
WQRL_ADDRESS="Q823b2FAeEbC9e1EE8e20454201502ef0679cC4AE"

# Optional. Defaults to the deployer when unset.
V2_FEE_TO_SETTER=""
