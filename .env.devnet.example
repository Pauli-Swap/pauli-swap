# Private QIP-55 devnet (quantum-ark), reached through `npm run vps:tunnel`
# in QuantumArk/infra/devnet. Copy to .env.devnet.
QRL_RPC_URL="http://127.0.0.1:8545"
QRL_CHAIN_ID=3151908
QRVM_NETWORK=devnet

# Same 34 word mnemonic as the testnet deployer; QIP-55 derives its 64 byte form.
DEPLOYER_MNEMONIC=""

# Optional. Unset deploys a fresh WQRL, which a private chain needs.
WQRL_ADDRESS=""
