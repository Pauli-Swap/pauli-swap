// SPDX-License-Identifier: GPL-3.0-or-later
pragma hyperion >=0.0;

/// @title Wrapped QRL
/// @notice SQRC-TF1 wrapper around the native Quanta, port of WETH9.
contract WQRL {
    string public name = "Wrapped QRL";
    string public symbol = "WQRL";
    uint8 public decimals = 18;

    event Approval(address indexed src, address indexed guy, uint256 wad);
    event Transfer(address indexed src, address indexed dst, uint256 wad);
    event Deposit(address indexed dst, uint256 wad);
    event Withdrawal(address indexed src, uint256 wad);

    // QRVM: hypc's auto-getter for a mapping keyed by `address` hashes the
    // key as a cleaned uint256 and reads the wrong slot (OC-V3-02, see
    // docs/QRVM.md), so the mapping is private behind an explicit view.
    mapping(address => uint256) private _balanceOf;
    mapping(address => mapping(address => uint256)) private _allowance;

    function balanceOf(address owner) public view returns (uint256) {
        return _balanceOf[owner];
    }

    function allowance(address owner, address spender) public view returns (uint256) {
        return _allowance[owner][spender];
    }

    receive() external payable {
        deposit();
    }

    function deposit() public payable {
        _balanceOf[msg.sender] += msg.value;
        emit Deposit(msg.sender, msg.value);
    }

    function withdraw(uint256 wad) public {
        require(_balanceOf[msg.sender] >= wad, "WQRL: INSUFFICIENT_BALANCE");
        _balanceOf[msg.sender] -= wad;
        (bool success,) = msg.sender.call{value: wad}(new bytes(0));
        require(success, "WQRL: QRL_TRANSFER_FAILED");
        emit Withdrawal(msg.sender, wad);
    }

    function totalSupply() public view returns (uint256) {
        return address(this).balance;
    }

    function approve(address guy, uint256 wad) public returns (bool) {
        _allowance[msg.sender][guy] = wad;
        emit Approval(msg.sender, guy, wad);
        return true;
    }

    function transfer(address dst, uint256 wad) public returns (bool) {
        return transferFrom(msg.sender, dst, wad);
    }

    function transferFrom(address src, address dst, uint256 wad) public returns (bool) {
        require(_balanceOf[src] >= wad, "WQRL: INSUFFICIENT_BALANCE");

        if (src != msg.sender && _allowance[src][msg.sender] != type(uint256).max) {
            require(_allowance[src][msg.sender] >= wad, "WQRL: INSUFFICIENT_ALLOWANCE");
            _allowance[src][msg.sender] -= wad;
        }

        _balanceOf[src] -= wad;
        _balanceOf[dst] += wad;

        emit Transfer(src, dst, wad);
        return true;
    }
}
